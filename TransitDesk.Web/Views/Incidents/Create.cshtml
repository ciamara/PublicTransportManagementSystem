@model TransitDesk.Web.ViewModels.IncidentReportViewModel

@{
    ViewData["Title"] = "Zgłoszenie incydentu drogowego";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Zgłoszenie incydentu drogowego</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="Incidents" asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="VehicleSideNumber" class="form-label"></label>
                            <input asp-for="VehicleSideNumber" type="number" class="form-control" placeholder="np. 1052" />
                            <span asp-validation-for="VehicleSideNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LineNumber" class="form-label"></label>
                            <input asp-for="LineNumber" class="form-control" placeholder="np. 6, 199, N1" />
                            <span asp-validation-for="LineNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OccurredAt" class="form-label"></label>
                            <input asp-for="OccurredAt" class="form-control" />
                            <span asp-validation-for="OccurredAt" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Wprowadź szczegółowy opis zdarzenia (od 20 do 500 znaków)..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="attachmentFile" class="form-label">Załącznik (zdjęcie lub PDF, maks. 5 MB)</label>
                            <input type="file" id="attachmentFile" name="attachmentFile" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
                            <span class="text-danger">@Html.ValidationMessage("attachmentFile")</span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Anuluj</a>
                            <button type="submit" class="btn btn-danger">Wyślij zgłoszenie</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}