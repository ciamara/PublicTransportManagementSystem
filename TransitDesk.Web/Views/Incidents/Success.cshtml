@{
    ViewData["Title"] = "Zgłoszenie przyjęte";
}

<div class="container mt-5 text-center">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success p-4">
            <h4 class="alert-heading">Przyjęto zgłoszenie</h4>
            <p class="mb-0">@TempData["SuccessMessage"]</p>
        </div>
    }
    <a asp-action="Create" class="btn btn-primary mt-3">Dodaj kolejne zgłoszenie</a>
</div>